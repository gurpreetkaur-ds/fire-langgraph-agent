
FIRE_API_KEY=fire_sk_your_key_here
FIRE_BASE_URL=https://fire.prosaga.net/v1
# Invite code: when set, creating an account requires it (and the legacy /api/analyze/stream needs it as X-Access-Token).
# REQUIRED before exposing the app publicly: every question spends Fire credit.
# Generate: python -c "import secrets; print(secrets.token_urlsafe(12))"
# AGENT_ACCESS_TOKEN=

# ---- Database ----
# One database for accounts, conversations, documents, vectors and evaluation data. Default: SQLite at data/evaluation.db
# (vector search then runs in Python: fine for development). Production: PostgreSQL with the pgvector extension.
# DATABASE_URL=postgresql+psycopg://agent@/agent?host=/path/to/socket/dir&port=5432

# ---- Accounts ----
# COOKIE_SECURE=true          # set behind HTTPS
# SESSION_DAYS=14
# ALLOW_SIGNUP=true           # false = no new accounts at all

# ---- Knowledge base / RAG ----
# UPLOAD_DIR=data/uploads     # original files, stored as <user_id>/<document_id>.<ext>
# MAX_UPLOAD_MB=15
# MAX_DOCUMENTS_PER_USER=200
# MAX_STORAGE_MB_PER_USER=250
# MAX_PDF_PAGES=600
# MAX_CHUNKS_PER_DOCUMENT=2000   # cost guard: larger documents are refused instead of being embedded
# RAG_CHUNK_SIZE=1200         # characters per chunk
# RAG_CHUNK_OVERLAP=200       # characters shared by consecutive chunks
# EMBEDDING_MODEL=text-embedding-3-small   # any Fire embedding model (GET /v1/models?function=embedding)
# EMBEDDING_DIMENSIONS=1536   # fixed by migration 0002; changing it needs a new migration + re-index
# EMBEDDING_BATCH_SIZE=64     # max 128 (Fire limit)
# RAG_TOP_K=6                 # max passages given to the generator
# RAG_CANDIDATE_K=24          # passages fetched per search query before reranking
# RAG_SIMILARITY_THRESHOLD=0.30   # minimum cosine similarity
# RAG_RELATIVE_CUTOFF=0.75    # drop passages scoring below this fraction of the best one (0 disables)
# RAG_CONTEXT_CHARS=12000     # context budget for the generator
# CHAT_HISTORY_TURNS=6        # previous turns sent with each question
# INGEST_WORKER=inline        # inline = index uploads inside the API process; off = don't index
# RATE_LIMIT_CHAT_PER_MINUTE=12
# RATE_LIMIT_UPLOADS_PER_HOUR=60

# ---- AI Evaluation Center (see docs/evaluation.md) ----
# Required to open the dashboard / use /api/eval/*. Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
EVAL_ADMIN_TOKEN=change-me
# Older name for DATABASE_URL (still honoured when DATABASE_URL is unset).
# EVAL_DATABASE_URL=
EVAL_ENABLED=true
EVAL_AUTO_MIGRATE=true
# inline = worker runs inside the API process; external = run `python -m evaluation.worker` separately
EVAL_WORKER_MODE=inline
EVAL_WORKER_POLL_SECONDS=2
# Model used as LLM judge (Fire species_name). Unset = Fire's default model.
# EVAL_JUDGE_MODEL=claude-sonnet-4-5
EVAL_SUITE_CONCURRENCY=3
# Prices per million tokens, per model. No built-in prices: unset => cost shows as "n/a". Verify against your Fire plan.
# EVAL_PRICING_JSON={"claude-haiku-4-5":{"input_per_mtok":1.0,"output_per_mtok":5.0},"claude-sonnet-4-5":{"input_per_mtok":3.0,"output_per_mtok":15.0}}
# Pass thresholds (0-1). Hallucination is a maximum, all others minimums.
# EVAL_THRESHOLD_FAITHFULNESS=0.80  EVAL_THRESHOLD_RELEVANCE=0.75  EVAL_THRESHOLD_GROUNDEDNESS=0.70
# EVAL_THRESHOLD_CITATION_ACCURACY=0.80  EVAL_THRESHOLD_TOOL_ACCURACY=0.80  EVAL_THRESHOLD_SAFETY=0.95  EVAL_THRESHOLD_HALLUCINATION=0.15
# Regression tolerance = allowed absolute drop between runs before a metric is "degraded" (default 0.01, safety 0.005)
# EVAL_REGRESSION_TOLERANCE_SAFETY=0.005
# EVAL_REGRESSION_LATENCY_PCT=0.20
