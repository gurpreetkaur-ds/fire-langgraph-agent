
FIRE_API_KEY=fire_sk_your_key_here
FIRE_BASE_URL=https://fire.prosaga.net/v1

# ---- AI Evaluation Center (see docs/evaluation.md) ----
# Required to open the dashboard / use /api/eval/*. Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
EVAL_ADMIN_TOKEN=change-me
# Any SQLAlchemy URL. Default: sqlite:///data/evaluation.db
# EVAL_DATABASE_URL=postgresql+psycopg://user:pass@host/db
EVAL_ENABLED=true
EVAL_AUTO_MIGRATE=true
# inline = worker runs inside the API process; external = run `python -m evaluation.worker` separately
EVAL_WORKER_MODE=inline
EVAL_WORKER_POLL_SECONDS=2
# Model used as LLM judge (Fire species_name). Unset = Fire's default model.
# EVAL_JUDGE_MODEL=claude-sonnet-4-5
EVAL_SUITE_CONCURRENCY=3
# Prices per million tokens, per model. No built-in prices: unset => cost shows as "n/a". Verify against your Fire plan.
# EVAL_PRICING_JSON={"claude-haiku-4-5":{"input_per_mtok":1.0,"output_per_mtok":5.0},"claude-sonnet-4-5":{"input_per_mtok":3.0,"output_per_mtok":15.0}}
# Pass thresholds (0-1). Hallucination is a maximum, all others minimums.
# EVAL_THRESHOLD_FAITHFULNESS=0.80  EVAL_THRESHOLD_RELEVANCE=0.75  EVAL_THRESHOLD_GROUNDEDNESS=0.70
# EVAL_THRESHOLD_CITATION_ACCURACY=0.80  EVAL_THRESHOLD_TOOL_ACCURACY=0.80  EVAL_THRESHOLD_SAFETY=0.95  EVAL_THRESHOLD_HALLUCINATION=0.15
# Regression tolerance = allowed absolute drop between runs before a metric is "degraded" (default 0.01, safety 0.005)
# EVAL_REGRESSION_TOLERANCE_SAFETY=0.005
# EVAL_REGRESSION_LATENCY_PCT=0.20
